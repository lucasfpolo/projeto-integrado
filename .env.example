# Configurações do Broker MQTT
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=8883
MQTT_USE_TLS=true
MQTT_TOPIC_PREFIX=topico_do_projeto_integrado

# Credenciais MQTT (deixe vazio se não utilizar autenticação)
MQTT_USERNAME=username
MQTT_PASSWORD=password

# Configurações do Simulador
PUBLISH_INTERVAL=10
N_SENSORES=3

# Configurações do Banco de Dados (TimescaleDB)
DB_PORT=5432
DB_NAME=sensors_database
DB_USER=username
DB_PASSWORD=password